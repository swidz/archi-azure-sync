/* Disposable models and synthetic denied requests only; never accesses a live tenant. */
(function () {
    var Paths=Java.type('java.nio.file.Paths'),root=String(Paths.get(__DIR__).getParent().toAbsolutePath());
    ['lib/core.js','lib/azure-client.js','lib/entra-applications.js','lib/java-runtime.js','lib/archi-adapter.js'].forEach(function(f){load(root+'/'+f);});
    var C=AzureCore,E=AzureEntra,checks=[];function ok(v,message){C.assert(v,message);checks.push(message);}
    var tenant='aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa',sub='11111111-1111-1111-1111-111111111111',sub2='22222222-2222-2222-2222-222222222222';
    var clock='2026-09-25T10:00:00Z',info={tenantId:tenant,subscriptionId:sub,displayName:'Primary',state:'Enabled'},info2={tenantId:tenant,subscriptionId:sub2,displayName:'Secondary',state:'Enabled'};
    var prefix='/subscriptions/'+sub+'/resourceGroups/group',rg={id:prefix,name:'group',type:'Microsoft.Resources/resourceGroups'};
    var sb={id:prefix+'/providers/Microsoft.ServiceBus/namespaces/bus',type:'Microsoft.ServiceBus/namespaces',name:'bus',sku:{tier:'Standard'}};
    var queue={id:sb.id+'/queues/queue',type:sb.type+'/queues',name:'queue'},topic={id:sb.id+'/topics/topic',type:sb.type+'/topics',name:'topic'};
    var sql={id:prefix+'/providers/Microsoft.Sql/servers/sql',type:'Microsoft.Sql/servers',name:'sql'},db={id:sql.id+'/databases/database',type:sql.type+'/databases',name:'database'};
    var vm={id:'/subscriptions/'+sub2+'/resourceGroups/other/providers/Microsoft.Compute/virtualMachines/vm',type:'Microsoft.Compute/virtualMachines',name:'vm'};
    var apps=[{id:'33333333-3333-3333-3333-333333333333',appId:'cccccccc-cccc-cccc-cccc-cccccccccccc',displayName:'Visible app'},
        {id:'44444444-4444-4444-4444-444444444444',appId:'dddddddd-dddd-dddd-dddd-dddddddddddd',displayName:'Hidden app'}];
    function full(){return {schemaVersion:3,partial:false,warnings:[],tenantId:tenant,subscriptionIds:[sub,sub2],completedSubscriptions:[sub,sub2],resources:[
        {id:'/subscriptions/'+sub,type:'Microsoft.Resources/subscriptions',name:info.displayName},rg,sb,queue,topic,sql,db
    ].map(function(r){return C.normalize(r,info,tenant);}).concat([C.normalize(vm,info2,tenant)]),confirmedMissing:[],collectedAt:clock};}
    function graphFull(){return {tenantId:tenant,completed:true,applications:apps,confirmedMissing:[],collectedAt:clock};}
    var m=$.model.create('Partial access smoke');m.setAsCurrent();
    function apply(arm,graph){var existing=AzureArchi.readElements(m),p=C.plan(existing,arm,{});if(graph)E.merge(p,E.plan(existing,graph,{},undefined,arm.collectedAt));AzureArchi.apply(m,p,{});return p;}
    function element(id){var found;$(m).find('element').each(function(e){e=e.concept||e;if(String(e.prop('Azure-ObjectId'))===id)found=e;});return found;}
    function relation(a,b){var found;$(m).find('relationship').each(function(r){r=r.concept||r;if(String(r.source.id)===String(a.id)&&String(r.target.id)===String(b.id))found=r;});return found;}
    function state(e){var p={};C.PROPS.concat(['Azure-SourceElementId','Azure-TargetElementId']).forEach(function(k){p[k]=String(e.prop(k));});return JSON.stringify({id:String(e.id),name:String(e.name),folder:String($(e).parent().first().id),properties:p});}
    apply(full(),graphFull());var q=element(queue.id),v=element(vm.id),hidden=element(apps[1].id),qr=relation(element(sb.id),q),tr=relation(element(sb.id),element(topic.id)),dr=relation(element(sql.id),element(db.id));
    qr.name='Preserve while unreadable';hidden.prop('IsDeleted','yes');hidden.prop('DeletedDate','2026-09-20');hidden.prop('DeletedTime','09:00:00Z');
    var protectedStates=[state(q),state(v),state(hidden),state(qr)],ids=[String(tr.id),String(dr.id)],success=String(m.prop('Azure-LastSuccessfulSyncAt')),entraSuccess=String(m.prop('Azure-LastSuccessfulEntraSyncAt'));
    clock='2026-09-26T12:00:00Z';db.name='Readable database';apps[0].displayName='Readable app';
    var denied={status:403,body:{error:{code:'AuthorizationFailed',message:'SECRET'}}},responses=[{status:200,body:info},{status:200,body:{value:[rg]}},{status:200,body:{value:[sb,sql]}},denied,{status:200,body:{value:[topic]}},{status:200,body:{value:[db]}},denied,denied],logs=[];
    function fake(list){return {now:function(){return Date.parse(clock);},sleep:function(){},request:function(){C.assert(list.length,'Unexpected synthetic request');return list.shift();}};}
    var token={accessToken:'synthetic',expiresAt:Date.parse(clock)+3600000},existing=AzureArchi.readElements(m);
    var arm=AzureClient.create(fake(responses),token,function(s){logs.push(s);}).inventory({tenantId:tenant,subscriptionIds:[sub,sub2]},existing);
    var graphResponses=[{status:200,body:{value:[apps[0]],'@odata.nextLink':'https://graph.microsoft.com/v1.0/applications?$select=id,appId,displayName&$skiptoken=next'}},denied,denied];
    var graph=E.create(fake(graphResponses),{accessToken:'synthetic',expiresAt:token.expiresAt,tenantId:tenant,resource:'graph'},function(s){logs.push(s);}).inventory(tenant,existing);
    ok(responses.length===0 && graphResponses.length===0,'Graal collectors continue after queue, subscription and Graph access denial');
    ok(arm.partial && graph.partial && !graph.completed && arm.confirmedMissing.length===0 && graph.confirmedMissing.length===0,'Incomplete scopes carry warnings and no deletion confirmations');
    var p=apply(arm,graph);
    ok(p.partial && p.counts.deleted===0 && p.counts.created===0,'Partial plan applies readable updates without false deletion or duplicate creation');
    ok(state(q)===protectedStates[0],'Unreadable queue retains all properties, name, folder and GUID');
    ok(state(v)===protectedStates[1],'Denied subscription element is untouched');
    ok(state(hidden)===protectedStates[2],'Unreadable Entra Node retains existing deletion status and timestamps');
    ok(state(qr)===protectedStates[3],'Relationship touching unreadable queue retains name, folder, timestamps and GUID');
    ok(String(element(db.id).name)==='Readable database' && String(element(db.id).prop('LastSyncDate'))==='2026-09-26','Readable SQL database updates during partial collection');
    ok(String(element(apps[0].id).name)==='Readable app' && String(element(apps[0].id).prop('LastSyncDate'))==='2026-09-26','Graph results from successful pages update Nodes');
    ok(String(tr.id)===ids[0] && String(dr.id)===ids[1] && String(tr.prop('LastSyncDate'))==='2026-09-26' && String(dr.prop('LastSyncDate'))==='2026-09-26','Readable topic composition and SQL serving links update in place');
    ok(String(m.prop('Azure-LastSuccessfulSyncAt'))===success && String(m.prop('Azure-LastSuccessfulEntraSyncAt'))===entraSuccess,'Partial runs do not advance complete-sync model timestamps');
    ok(String(m.prop('Azure-LastSyncStatus'))==='partial' && String(m.prop('Azure-LastSyncAttemptAt'))===C.stamp(clock).iso && Number(m.prop('Azure-LastSyncWarningCount'))===p.warnings.length,'Model records partial status, attempt time and warning count');
    ok(logs.some(function(s){return s.indexOf('[WARNING]')===0 && s.indexOf('HTTP 403')>=0;}) && !logs.join('').includes('SECRET'),'Output warnings identify denied reads without raw server messages');
    var repeat=apply(arm,graph);ok(repeat.counts.created===0 && state(qr)===protectedStates[3],'Repeating partial sync preserves GUIDs and unreadable links');
    clock='2026-09-27T12:00:00Z';apply(full(),graphFull());
    ok(String(m.prop('Azure-LastSyncStatus'))==='complete' && String(m.prop('Azure-LastSuccessfulSyncAt'))===C.stamp(clock).iso && String(m.prop('Azure-LastSyncWarningCount'))==='0','Later complete run restores complete status and advances success timestamps');
    ok(String(qr.name)==='' && String(hidden.prop('IsDeleted'))==='no' && String(hidden.prop('DeletedDate'))==='' && String(q.prop('LastSyncDate'))==='2026-09-27','Restored access resumes relationship cleanup and element reconciliation');
    ok($(m).find('view').size()===0 && m.specializations.length===0,'Partial and complete syncs create no diagrams or default profiles');
    var dir=AzureJava.resolve(root,'work');m.save(dir+'/partial-smoke.archimate');var loaded=$.model.load(dir+'/partial-smoke.archimate');
    ok(String(loaded.prop('Azure-LastSyncStatus'))==='complete' && AzureArchi.readElements(loaded).length===10,'Partial-run metadata and elements survive save/reload');
    AzureJava.write(dir+'/partial-smoke-result.json',JSON.stringify({status:'passed',archi:String($.process.release.archiVersion),jArchi:String($.process.release.jArchiVersion),checks:checks},null,2));
    console.log('ARCHI_PARTIAL_SYNC_SMOKE_PASSED');
}());
