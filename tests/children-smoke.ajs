/* Synthetic ARM responses and disposable models only; no credentials or Azure calls. */
(function () {
    var Paths=Java.type('java.nio.file.Paths'),root=String(Paths.get(__DIR__).getParent().toAbsolutePath());
    ['lib/core.js','lib/azure-client.js','lib/java-runtime.js','lib/archi-adapter.js','config/specializations.js'].forEach(function(f){load(root+'/'+f);});
    var C=AzureCore,checks=[];function ok(value,message){C.assert(value,message);checks.push(message);}
    var tenant='aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa',sub='11111111-1111-1111-1111-111111111111',sub2='22222222-2222-2222-2222-222222222222';
    var prefix='/subscriptions/'+sub+'/resourceGroups/demo',info={subscriptionId:sub,displayName:'Synthetic',tenantId:tenant,state:'Enabled'};
    var rg={id:prefix,name:'demo'},bus={id:prefix+'/providers/Microsoft.ServiceBus/namespaces/bus',type:'Microsoft.ServiceBus/namespaces',name:'bus',sku:{tier:'Standard'}};
    var app={id:prefix+'/providers/Microsoft.Web/sites/app',type:'Microsoft.Web/sites',name:'app',kind:'functionapp,linux'},sql={id:prefix+'/providers/Microsoft.Sql/servers/sql',type:'Microsoft.Sql/servers',name:'sql'};
    function child(parent,collection,name){return {id:parent.id+'/'+collection+'/'+name,type:parent.type+'/'+collection,name:name};}
    var q=child(bus,'queues','orders'),t=child(bus,'topics','events'),f=child(app,'functions','process'),db=child(sql,'databases','data');
    function page(value){return {status:200,body:{value:value}};}
    var responses=[{status:200,body:info},page([rg]),page([bus,app,sql,db]),page([q]),page([t]),page([f]),page([db])];
    var now=Date.parse('2026-09-25T10:20:30Z'),io={now:function(){return now;},sleep:function(){},request:function(method){C.assert(method==='GET' && responses.length,'Unexpected request');return responses.shift();}};
    var snapshot=AzureClient.create(io,{accessToken:'synthetic',expiresAt:now+3600000}).inventory({tenantId:tenant,subscriptionIds:[sub]},[]);
    ok(snapshot.resources.length===9 && responses.length===0,'Graal collector expands Service Bus, Functions and SQL without duplicate database');
    var m=$.model.create('Azure child resources smoke');m.setAsCurrent();var map=C.mappings(AZURE_SPECIALIZATIONS),views=$(m).find('view').size();
    function sync(options){var p=C.plan(AzureArchi.readElements(m),snapshot,map,options);var result=AzureArchi.apply(m,p,options);return {plan:p,result:result};}
    function concept(id){var found;$(m).find('element').each(function(e){e=e.concept||e;if(String(e.prop('Azure-ObjectId'))===id)found=e;});return found;}
    function relationships(){var out=[];$(m).find('relationship').each(function(r){out.push(r);});return out;}
    function link(a,b,type){return relationships().filter(function(r){return String(r.source.prop('Azure-ObjectId'))===a.id && String(r.target.prop('Azure-ObjectId'))===b.id && String(r.type)===type;})[0];}
    function trail(e){var out=[],p=$(e).parent().first();while(p && String(p.type)==='folder'){out.unshift(p);p=$(p).parent().first();}return out;}
    function hierarchy(e){return trail(e).slice(1).map(function(p){return String(p.name);}).join('|');}
    function folderIds(){var ids=[];$(m).find('folder').each(function(p){ids.push(String(p.id));});return ids.sort().join(',');}
    var first=sync();ok(first.result.relationships.created===11 && relationships().length===11,'Creates all valid resource-group and service relationships');
    ok(relationships().every(function(r){return String(r.name)==='';}),'New composition, assignment and SQL serving relationships have blank names');
    var relationFolder=trail(relationships()[0])[1],relationFolderId=String(relationFolder.id),relationLayer=trail(relationships()[0])[0];
    ok(String(relationFolder.name)==='Azure' && String($(relationLayer).parent().first().id)===String(m.id),'Generated relationships are in Relationships / Azure');
    ok(relationships().every(function(r){return hierarchy(r)===hierarchy(r.source);}), 'Every relationship mirrors its source object folder hierarchy');
    var expectedPrefix='Azure|Synthetic ['+sub+']|demo|';
    ok(hierarchy(link(bus,q,'composition-relationship'))===expectedPrefix+'Microsoft.ServiceBus/namespaces' && hierarchy(link(app,f,'assignment-relationship'))===expectedPrefix+'Microsoft.Web/sites' && hierarchy(link(sql,db,'serving-relationship'))===expectedPrefix+'Microsoft.Sql/servers','Service relationships are grouped by source type rather than child type');
    ok(hierarchy(link({id:'/subscriptions/'+sub},rg,'composition-relationship'))==='Azure|Synthetic ['+sub+']|Other|Microsoft.Resources/subscriptions','Subscription-source links use Other even though the target is a resource group');
    ok(relationships().every(function(r){return String(r.prop('Azure-SourceElementId'))===String(r.source.id) && String(r.prop('Azure-TargetElementId'))===String(r.target.id);}), 'Generated relationships record actual source and target Archi GUIDs');
    ok(String(concept(f.id).type)==='technology-function','Individual Function uses Technology Function');
    ok(String(concept(f.id).prop('Azure-ParentObjectId'))===app.id,'Child records parent Azure ID');
    ok(!!link(bus,q,'composition-relationship') && !!link(bus,t,'composition-relationship'),'Service Bus consists of queues and topics');
    ok(!!link(app,f,'assignment-relationship') && !link(rg,f,'composition-relationship'),'Function App assigns Technology Function without invalid Node composition');
    ok(!!link(sql,db,'serving-relationship'),'SQL server serves its database');
    ok($(m).find('view').size()===views && m.specializations.length===0,'No diagrams or specializations generated');
    var ids=relationships().map(function(r){return String(r.id);}).sort().join(','),elementIds=AzureArchi.readElements(m).map(function(e){return e.id;}).sort().join(',');
    relationships().forEach(function(r){r.name=String(r.type)==='serving-relationship'?'serves':String(r.type)==='assignment-relationship'?'performs':String(r.source.prop('Azure-ObjectType'))==='Microsoft.ServiceBus/namespaces'?'consists of':'composed of';});
    var foldersBefore=folderIds();
    ok(sync().result.relationships.created===0 && relationships().map(function(r){return String(r.id);}).sort().join(',')===ids,'Repeated sync preserves all relationship IDs');
    ok(relationships().every(function(r){return String(r.name)==='';}),'Repeat sync clears every existing generated label, including SQL serving');
    ok(folderIds()===foldersBefore,'Repeated sync preserves relationship hierarchy folder IDs without duplicates');
    var legacy=relationLayer.createFolder('Legacy relationships'),candidate=link(bus,q,'composition-relationship'),candidateId=String(candidate.id),candidateFolderId=String($(candidate).parent().first().id);
    relationFolder.add(candidate);sync();
    ok(String($(candidate).parent().first().id)===candidateFolderId && String(candidate.id)===candidateId,'Flat Azure relationships migrate into source hierarchy while preserving identity');
    legacy.add(candidate);candidate.name='Customized relationship label';candidate.prop('Azure-SourceElementId','stale');candidate.prop('Azure-TargetElementId','stale');candidate.prop('Azure-SourceObjectId','stale');
    var createdDate=String(candidate.prop('CreatedDate'));
    ok(sync().result.relationships.created===0 && String(candidate.id)===candidateId && String(candidate.name)==='','GUID matching reuses the relationship and clears its custom label despite stale cached metadata');
    ok(String($(candidate).parent().first().id)===candidateFolderId && String(candidate.prop('CreatedDate'))===createdDate,'Migration to Azure preserves relationship GUID and creation date');
    ok(String(candidate.prop('Azure-SourceElementId'))===String(candidate.source.id) && String(candidate.prop('Azure-TargetElementId'))===String(candidate.target.id),'Stored endpoint GUIDs refresh from actual endpoints');
    relationLayer.name='Translated Relationships';sync({rootFolderName:'Cloud estate'});
    ok(String(relationFolder.name)==='Cloud estate' && String(relationFolder.id)===relationFolderId,'Relationship root follows configured name without changing folder identity');
    sync();ok(String(relationFolder.name)==='Azure','Translated relationship category is resolved without hardcoded label');
    var beforeRename=folderIds();snapshot.resources.forEach(function(r){r.subscriptionName='Renamed subscription';});sync();
    ok(folderIds()===beforeRename && String(trail(candidate)[2].name)==='Renamed subscription ['+sub+']','Source subscription rename updates relationship labels while retaining folder IDs');
    snapshot.resources.forEach(function(r){r.subscriptionName='Synthetic';});sync();
    // A different relation type between the same endpoints must not mask an existing serving link.
    var extra=m.createRelationship('association-relationship','User note',concept(sql.id),concept(db.id));sync();
    ok(relationships().length===12 && !!link(sql,db,'serving-relationship'),'Relationship matching includes type and preserves unrelated links');
    var original=snapshot.resources.slice(),children=[q,t,f,db],owned=relationships().filter(function(r){return String(r.prop('Azure-SyncManagedBy'))===C.OWNER && children.some(function(c){return String(r.target.prop('Azure-ObjectId'))===c.id;});});
    owned.forEach(function(r){r.name='Old deleted link label';});
    snapshot.resources=original.filter(function(r){return !C.childSpec(r.type);});snapshot.confirmedMissing=children.map(function(c){return C.identity(tenant,c.id);});snapshot.collectedAt='2026-09-26T11:22:33Z';sync();
    ok(owned.every(function(r){return String(r.prop('IsDeleted'))==='yes' && String(r.prop('DeletedDate'))==='2026-09-26' && String(r.name)==='';}),'Deletion soft-deletes owned composition, assignment and serving links and clears their names');
    snapshot.collectedAt='2026-09-27T12:00:00Z';sync();ok(owned.every(function(r){return String(r.prop('DeletedDate'))==='2026-09-26';}),'Repeated deletion retains relationship deletion timestamps');
    snapshot.resources=original;snapshot.confirmedMissing=[];sync();
    ok(owned.every(function(r){return String(r.prop('IsDeleted'))==='no' && String(r.prop('DeletedDate'))==='';}) && AzureArchi.readElements(m).map(function(e){return e.id;}).sort().join(',')===elementIds,'Child restoration retains concept and relationship identity');
    // Empty selected scope in another subscription must leave existing service links alone.
    var saved=owned.map(function(r){return String(r.prop('LastSyncDate'));}).join(',');
    snapshot.subscriptionIds=[sub2];snapshot.completedSubscriptions=[sub2];snapshot.resources=[];snapshot.collectedAt='2026-09-28T12:00:00Z';sync();
    ok(owned.map(function(r){return String(r.prop('LastSyncDate'));}).join(',')===saved,'Unselected service relationships keep timestamps');
    snapshot.subscriptionIds=[sub];snapshot.completedSubscriptions=[sub];snapshot.resources=original;
    var serving=link(sql,db,'serving-relationship'),source=serving.source,target=serving.target;serving.delete();
    var manual=m.createRelationship('serving-relationship','Manual serves',source,target);manual.prop('UserNote','preserve');var manualParent=String($(manual).parent().first().id);
    ok(sync().result.relationships.created===0 && String(manual.name)==='Manual serves' && !manual.prop('Azure-SyncManagedBy'),'Manual serving relationship reused without ownership takeover');
    ok(String($(manual).parent().first().id)===manualParent,'Reused manual relationships keep their original folder');
    var dir=AzureJava.resolve(root,'work');Java.type('java.nio.file.Files').createDirectories(Paths.get(dir));m.save(dir+'/children-smoke.archimate');var loaded=$.model.load(dir+'/children-smoke.archimate');
    ok(AzureArchi.readElements(loaded).length===9 && $(loaded).find('relationship').size()===12,'Children and mixed relationship types survive save/reload');
    var loadedOwned=[];$(loaded).find('relationship').each(function(r){if(String(r.prop('Azure-SyncManagedBy'))===C.OWNER)loadedOwned.push(r);});
    ok(loadedOwned.every(function(r){return hierarchy(r)===hierarchy(r.source) && String(trail(r)[1].id)===relationFolderId && String(r.prop('Azure-SourceElementId'))===String(r.source.id) && String(r.name)==='';}), 'Relationship hierarchy, endpoint GUIDs and blank names survive save/reload');
    AzureJava.write(dir+'/children-smoke-result.json',JSON.stringify({status:'passed',archi:String($.process.release.archiVersion),jArchi:String($.process.release.jArchiVersion),checks:checks},null,2));
    console.log('ARCHI_AZURE_CHILDREN_SMOKE_PASSED');
}());
