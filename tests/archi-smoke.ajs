    var C = AzureCore, checks = [];
    function ok(value, message) { C.assert(value, message); checks.push(message); }
    var m = $.model.create("Azure folder and image smoke test"); m.setAsCurrent();
    var tenant="aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",sub="11111111-1111-1111-1111-111111111111",sub2="22222222-2222-2222-2222-222222222222";
    var mapping=C.mappings(AZURE_SPECIALIZATIONS);
    function resource(subscription, group, type, name) {
        var id="/subscriptions/"+subscription+(group?"/resourceGroups/"+group:"")+"/providers/"+type+"/"+name;
        return C.normalize({id:id,type:type,name:name},{subscriptionId:subscription,displayName:"Test"},tenant);
    }
    var vm=resource(sub,"demo","Microsoft.Compute/virtualMachines","vm-smoke");
    var snapshot={tenantId:tenant,subscriptionIds:[sub],completedSubscriptions:[sub],resources:[vm],confirmedMissing:[],collectedAt:"2026-09-25T10:20:30Z"};
    function sync(options) {
        var p=C.plan(AzureArchi.readElements(m),snapshot,mapping,options);
        if(options && options.useSpecializations) {
            var used={}; p.operations.forEach(function(op){if(op.specialization)used[C.lower(op.properties["Azure-ObjectType"])]=mapping[C.lower(op.properties["Azure-ObjectType"])];});
            AzureArchi.applyProfiles(m,AzureArchi.prepareProfiles(m,used,root,false,false));
        }
        AzureArchi.apply(m,p,options); return p;
    }
    function concept(id) { var result; $(m).find("element").each(function(e){e=e.concept||e;if(String(e.prop("Azure-ObjectId"))===id)result=e;});return result; }
    function ancestry(e) { var names=[],p=$(e).parent().first();while(p && String(p.type)==="folder"){names.unshift(String(p.name));p=$(p).parent().first();}return names; }
    sync();
    var element=concept(vm.id),id=String(element.id),folderId=String($(element).parent().first().id);
    ok(m.specializations.length===0 && !element.specialization,"No specializations created by default");
    ok(ancestry(element).slice(1).join("|")==="Azure|Test ["+sub+"]|demo|Microsoft.Compute/virtualMachines","Subscription/resource group/type hierarchy");
    ok(String(element.prop("CreatedTime"))==="10:20:30Z","UTC creation timestamps");
    var peer=m.createElement("node","Unmanaged peer"),rel=m.createRelationship("association-relationship","Preserve",element,peer),relId=String(rel.id);
    var view=m.createArchimateView("Images"),view2=m.createArchimateView("Second occurrence");
    var a=view.add(element,50,50,240,100),b=view2.add(element,20,30,220,90),untouched=view.add(peer,350,50,120,80);
    untouched.imagePosition=8;
    a.image=null;b.image=null;a.imageSource=1;b.imageSource=1;
    a.imagePosition=8;a.textPosition=0;a.textAlignment=4;
    var savedIconLookup=AzureJava.icon;AzureJava.icon=function(){throw new Error("Sync must not load icon assets");};
    try { sync(); } finally { AzureJava.icon=savedIconLookup; }
    ok(a.image===null && b.image===null && a.imageSource===1 && a.imagePosition===8 && a.textPosition===0 && a.textAlignment===4,"Standard sync preserves icon-free diagram objects and manual text positioning");
    ok(!m.prop("Azure-ImagePosition") && !m.prop("Azure-TextPosition"),"Sync does not store appearance settings");
    var syncBeforeAppearance=String(m.prop("Azure-LastSuccessfulSyncAt"));
    AzureArchi.applyAppearance(m,AzureArchi.prepareAppearance(m,mapping,root),{});
    ok(a.image!==null && b.image!==null && a.textPosition===2 && a.textAlignment===2,"Offline utility formats manually placed objects without another sync");
    ok(String(m.prop("Azure-LastSuccessfulSyncAt"))===syncBeforeAppearance,"Offline appearance preserves synchronization timestamps");
    var decoded=Java.type("javax.imageio.ImageIO").read(new (Java.type("java.io.File"))(AzureJava.icon(root,mapping[C.lower(vm.type)].icon)));
    ok(Math.max(decoded.getWidth(),decoded.getHeight())===48,"Bundled icon has half the previous 96 pixel dimensions");
    AzureArchi.applyAppearance(m,AzureArchi.prepareAppearance(m,mapping,root),{imagePosition:"bottom-right",textPosition:"top-left"});
    ok(a.imagePosition===8 && a.textPosition===0 && a.textAlignment===1,"Configurable image and text positions");
    var foldersBefore=$(m).find("folder").size(); sync();
    ok(a.imagePosition===8 && a.textPosition===0 && a.textAlignment===1 && a.imageSource===1,"Sync preserves existing custom images and their manual placement");
    AzureArchi.applyAppearance(m,AzureArchi.prepareAppearance(m,mapping,root),{});
    ok(AzureArchi.readElements(m).length===1 && String(element.id)===id,"Repeat sync preserves identity across views");
    ok($(m).find("folder").size()===foldersBefore && String($(element).parent().first().id)===folderId,"Repeat sync reuses folder IDs");
    ok(a.image!==null && b.image!==null && a.imageSource===1 && b.imageSource===1,"Custom images on every diagram occurrence");
    ok(a.imagePosition===1 && b.imagePosition===1 && a.textPosition===2 && a.textAlignment===2,"Top Center image and Bottom Center label placement");
    ok(a.bounds.x===50 && a.bounds.width===240 && b.bounds.y===30 && untouched.imagePosition===8,"Diagram bounds and unmanaged visuals preserved");
    snapshot.resources=[];snapshot.confirmedMissing=[C.identity(tenant,vm.id)];sync();
    ok(String(element.prop("IsDeleted"))==="yes","Soft deletion keeps folder and concept");
    snapshot.resources=[vm];snapshot.collectedAt="2026-09-26T11:22:33Z";sync();
    ok(String(element.prop("DeletedDate"))==="" && String(element.prop("CreatedTime"))==="10:20:30Z","Restoration preserves creation and clears deletion");
    sync({useSpecializations:true});
    ok(!!element.specialization && m.specializations.length===1 && a.imageSource===1 && a.imagePosition===1 && m.findSpecialization(element.specialization,"node").image===null,"Opt-in sync profiles have no new icons and do not change diagram image source");
    var profileMapping={};profileMapping[C.lower(vm.type)]=mapping[C.lower(vm.type)];
    AzureArchi.applyProfiles(m,AzureArchi.prepareProfiles(m,profileMapping,root,false));
    sync({useSpecializations:true});
    ok(m.findSpecialization(element.specialization,"node").image!==null && a.imageSource===1,"Sync preserves existing optional profile icons without changing custom image source");
    sync();
    ok(!element.specialization && m.specializations.length===1 && a.imageSource===1,"Turning off detaches managed assignment without deleting definitions");
    vm.subscriptionName="Renamed subscription";sync({rootFolderName:"Cloud estate"});
    ok(ancestry(element)[1]==="Cloud estate" && ancestry(element)[2]==="Renamed subscription ["+sub+"]" && String($(element).parent().first().id)===folderId,"Root/subscription rename retains folder identity");
    var noGroup=resource(sub,"","Microsoft.Resources/deployments","subscription-deployment"),realOther=resource(sub,"Other","Microsoft.Compute/virtualMachines","other-vm"),other=resource(sub2,"demo","Microsoft.Compute/virtualMachines","other-sub-vm");
    snapshot.resources=[vm,noGroup,realOther,other]; snapshot.subscriptionIds=[sub,sub2];snapshot.completedSubscriptions=[sub,sub2];sync();
    ok(ancestry(concept(noGroup.id))[3]==="Other","No resource group uses Other");
    ok(ancestry(concept(realOther.id))[3]==="Other (resource group)","Real Other resource group remains distinct");
    ok(ancestry(concept(other.id))[2]!==ancestry(element)[2],"Subscription IDs prevent display-name collisions");
    var otherElement=concept(other.id),otherVisual=view.add(otherElement,300,250,200,90);otherVisual.imagePosition=8;
    var oldSync=String(otherElement.prop("LastSyncTime")); snapshot.resources=[vm,noGroup,realOther];snapshot.subscriptionIds=[sub];snapshot.completedSubscriptions=[sub];snapshot.collectedAt="2026-09-27T01:02:03Z";sync();
    ok(otherVisual.imagePosition===8 && String(otherElement.prop("LastSyncTime"))===oldSync,"Unselected subscription is untouched");
    // Migrate a formerly flat managed concept back into the hierarchy, preserving references.
    var layer=$(element).parent().first();while(String($(layer).parent().first().type)==="folder")layer=$(layer).parent().first();
    layer.name="Translated layer";layer.add(element);sync();
    ok(String($(element).parent().first().id)===folderId && String(element.id)===id,"Flat-element migration works with translated layer name");
    ok(String(rel.id)===relId && a.concept.id===element.id,"Relationships and diagram references survive migration");
    var dir=AzureJava.resolve(root,"work");Java.type("java.nio.file.Files").createDirectories(Paths.get(dir));
    m.save(dir+"/smoke.archimate");var loaded=$.model.load(dir+"/smoke.archimate");
    ok(AzureArchi.readElements(loaded).length===4,"Saved folder hierarchy and properties reload");
    var reloadedImage=false;$(loaded).find("element").each(function(o){if(o.concept && String(o.concept.id)===id)reloadedImage=o.image!==null && o.imageSource===1 && o.imagePosition===1;});
    ok(reloadedImage,"Embedded custom icon and Top Center persist after reload");
    AzureArchi.applyProfiles(m,AzureArchi.prepareProfiles(m,{},root,true));
    ok(AzureArchi.readElements(m).length===4 && String(rel.id)===relId,"Explicit profile removal preserves elements and relationships");
    // Real relationship API, lifecycle and scope in a separate disposable model.
    var rm=$.model.create("Containment smoke test");rm.setAsCurrent();
    function containers(subscription,groupName) {
        var info={subscriptionId:subscription,displayName:"Test"};
        return [C.normalize({id:"/subscriptions/"+subscription,type:"Microsoft.Resources/subscriptions",name:"Test"},info,tenant),
            C.normalize({id:"/subscriptions/"+subscription+"/resourceGroups/"+groupName,type:"Microsoft.Resources/resourceGroups",name:groupName},info,tenant)];
    }
    var first=containers(sub,"demo"),second=containers(sub2,"demo"),r1=resource(sub,"demo","Microsoft.Compute/virtualMachines","first"),r2=resource(sub2,"demo","Microsoft.Compute/virtualMachines","second");
    var rs={tenantId:tenant,subscriptionIds:[sub,sub2],completedSubscriptions:[sub,sub2],resources:first.concat(second,[r1,r2]),confirmedMissing:[],collectedAt:"2026-09-25T10:20:30Z"};
    function rSync(){var rp=C.plan(AzureArchi.readElements(rm),rs,mapping);return AzureArchi.apply(rm,rp,{});}
    function rRels(){var out=[];$(rm).find("relationship").each(function(r){out.push(r);});return out;}
    var beforeViews=$(rm).find("view").size(),rr=rSync(),relations=rRels(),relationIds=relations.map(function(r){return String(r.id);}).sort().join(",");
    ok(rr.relationships.created===4 && relations.length===4,"Creates subscription/group and group/resource compositions");
    ok($(rm).find("view").size()===beforeViews,"Sync creates no diagrams");
    relations.forEach(function(r){ok(String(r.type)==="composition-relationship" && String(r.name)==="composed of" && String(r.source.prop("Azure-SubscriptionId"))===String(r.target.prop("Azure-SubscriptionId")),"Valid composition direction and subscription scope");});
    rr=rSync();ok(rr.relationships.created===0 && rRels().map(function(r){return String(r.id);}).sort().join(",")===relationIds,"Repeated sync reuses relationship IDs without duplicates");
    var ownedLink,unselectedLink;relations.forEach(function(r){if(String(r.target.prop("Azure-ObjectId"))===r1.id)ownedLink=r;if(String(r.target.prop("Azure-ObjectId"))===r2.id)unselectedLink=r;});
    var savedUnselected=String(unselectedLink.prop("LastSyncDate")),createdDate=String(ownedLink.prop("CreatedDate"));
    rs.subscriptionIds=[sub];rs.completedSubscriptions=[sub];rs.resources=first;rs.confirmedMissing=[C.identity(tenant,r1.id)];rs.collectedAt="2026-09-26T11:22:33Z";rSync();
    ok(String(ownedLink.prop("IsDeleted"))==="yes" && String(ownedLink.prop("DeletedDate"))==="2026-09-26","Deleted resource soft-deletes its owned composition");
    rs.collectedAt="2026-09-27T01:02:03Z";rSync();ok(String(ownedLink.prop("DeletedDate"))==="2026-09-26","Repeated missing run retains relationship deletion date");
    ok(String(unselectedLink.prop("LastSyncDate"))===savedUnselected && String(unselectedLink.prop("IsDeleted"))==="no","Unselected relationships retain metadata");
    rs.resources=first.concat([r1]);rs.confirmedMissing=[];rSync();
    ok(String(ownedLink.prop("IsDeleted"))==="no" && String(ownedLink.prop("DeletedDate"))==="" && String(ownedLink.prop("CreatedDate"))===createdDate,"Restoration reuses composition and clears deletion metadata");
    var source=ownedLink.source,target=ownedLink.target;ownedLink.delete();var manual=rm.createRelationship("composition-relationship","User label",source,target);manual.prop("UserNote","keep");
    rr=rSync();ok(rr.relationships.created===0 && rRels().length===4 && String(manual.name)==="User label" && String(manual.prop("UserNote"))==="keep" && !manual.prop("Azure-SyncManagedBy"),"Manual composition is reused without taking ownership");
    rm.save(dir+"/composition-smoke.archimate");var restored=$.model.load(dir+"/composition-smoke.archimate");
    ok($(restored).find("relationship").size()===4 && $(restored).find("view").size()===beforeViews,"Relationships persist after reload without generated diagrams");
    m.setAsCurrent();
    // Utility remains usable at full catalog scale when explicitly enabled.
    AzureArchi.applyProfiles(m,AzureArchi.prepareProfiles(m,mapping,root,true));
    AzureArchi.applyProfiles(m,AzureArchi.prepareProfiles(m,mapping,root,true));
    ok(m.specializations.length===Object.keys(mapping).length,"Full catalog opt-in installation is idempotent");
    AzureJava.write(dir+"/archi-smoke-result.json",JSON.stringify({status:"passed",archi:String($.process.release.archiVersion),jArchi:String($.process.release.jArchiVersion),specializations:Object.keys(mapping).length,checks:checks},null,2));
    console.log("ARCHI_AZURE_SMOKE_PASSED");
}());